# A zero-byte dump and a .tmp are interrupted dumps, even where the pattern matches them.
volume empty
pattern app-*
dump app-20261019-190000.dump 64
dump app-20261019-200000.dump 64
dump app-20261019-210000.dump 0
dump app-20261019-220000.dump.tmp 64
expect-action Restore
expect-dump app-20261019-200000.dump
expect-validator-runs 1
